{
  "name": "frametv-art-gallery-frontend",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.1.0",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev --host",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "electron:start": "electron \".\"",
    "electron:dist": "pnpm build && electron-builder"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "error"
    }
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@lottiefiles/dotlottie-react": "^0.19.4",
    "@react-router/node": "8.3.0",
    "@react-router/serve": "8.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cropperjs": "^2.1.1",
    "isbot": "^5.1.40",
    "lucide-react": "^1.16.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.1",
    "react": "^19.2.6",
    "react-cropper": "^2.3.3",
    "react-dom": "^19.2.8",
    "react-router": "8.3.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@react-router/dev": "8.3.0",
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^22",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.4",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "shadcn": "^4.10.0",
    "tailwindcss": "^4.1.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vite-tsconfig-paths": "^6.1.1"
  },
    "build": {
    "appId": "com.mrtncode.frametv-art-gallery",
    "files": [
      "main.js",
      "build/client/**/*" 
    ],
    "extraResources": [
      {
        "from": "../build-backend/flask_backend",
        "to": "flask_backend",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "public/icon.icns"
    },
    "linux": {
      "target": "AppImage", 
      "icon": "public/icon.png" 
    }
  }
}
